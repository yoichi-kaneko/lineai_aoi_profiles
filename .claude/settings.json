{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh pr:*)",
      "Bash(gh repo *)",
      "Bash(npm install *)",
      "Bash(pnpm exec *)",
      "Bash(git add:*)",
      "Bash(git branch *)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git pull *)",
      "Bash(git push:*)",
      "Bash(git rev-parse *)",
      "Bash(git status *)",
      "Bash(git switch:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Edit(/.claude/skills/get_firestore_docs/**)",
      "Edit(/.claude/skills/put_firestore_doc/**)",
      "Edit(/.claude/skills/review_image_feedback/**)",
      "Edit(/.claude/skills/run_aoi_daily/**)",
      "Edit(/.claude/skills/send_line_audio/**)",
      "Edit(/.claude/skills/send_line_image/**)",
      "Edit(/.claude/skills/send_line_text/**)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --force *)",
      "Bash(git push --force=*)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push origin main *)"
    ]
  }
}
