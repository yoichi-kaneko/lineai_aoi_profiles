# GCP Secret Manager への参照（実際のシークレット値はここに記載しない）
# フォーマット: ENV_VAR_NAME=SECRET_NAME:VERSION
LINE_CHANNEL_SECRET=LINE_CHANNEL_SECRET:latest
AWS_ACCESS_KEY=AWS_ACCESS_KEY:latest
AWS_SECRET_KEY=AWS_SECRET_KEY:latest
LINE_ACCESS_TOKEN=LINE_ACCESS_TOKEN:latest
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY:latest
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET:latest
