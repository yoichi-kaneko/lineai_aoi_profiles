{
    "name": "lineai_aoi_profiles",
    "private": true,
    "workspaces": [
        "functions"
    ],
    "scripts": {
    "agent-config:sync": "node scripts/sync-agent-config.mjs",
    "agent-config:check": "node scripts/sync-agent-config.mjs --check",
    "check:functions-lock": "node scripts/check-functions-lock.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "pnpm --filter aoi-functions test",
    "test:all": "pnpm agent-config:check && pnpm check:functions-lock && pnpm test && pnpm test:functions"
    },
    "dependencies": {
        "@doist/todoist-sdk": "9.8.0",
        "@google/genai": "1.52.0",
        "@googlemaps/google-maps-services-js": "^3.4.2",
        "@line/bot-sdk": "^10.6.0",
        "cheerio": "^1.2.0",
        "cloudinary": "2.11.0",
        "dotenv": "^16.4.7",
        "firebase-admin": "13.10.0",
        "google-auth-library": "10.9.1",
        "googleapis": "^178.0.0",
        "openai": "6.49.0",
        "qrcode": "^1.5.4",
        "sharp": "0.35.4",
        "twitter-api-v2": "1.29.1",
        "type-fest": "^4.12.0"
    },
    "devDependencies": {
        "@types/node": "22.20.2",
        "@types/qrcode": "^1.5.5",
        "tsx": "4.23.13",
        "typescript": "7.0.2",
        "vitest": "5.0.0"
    },
    "optionalDependencies": {
        "@esbuild/linux-x64": "0.28.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@firebase/util",
            "esbuild",
            "protobufjs"
        ]
    },
    "packageManager": "pnpm@10.34.5"
}
