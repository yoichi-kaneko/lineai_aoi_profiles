{
    "name": "lineai_aoi_profiles",
    "private": true,
    "workspaces": [
        "functions"
    ],
    "scripts": {
    "agent-config:sync": "node scripts/sync-agent-config.mjs",
    "agent-config:check": "node scripts/sync-agent-config.mjs --check",
    "check:functions-lock": "node scripts/check-functions-lock.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "pnpm --filter aoi-functions test",
    "test:all": "pnpm agent-config:check && pnpm check:functions-lock && pnpm test && pnpm test:functions"
    },
    "dependencies": {
        "@doist/todoist-sdk": "15.3.0",
        "@google/genai": "2.24.0",
        "@googlemaps/google-maps-services-js": "3.4.2",
        "@line/bot-sdk": "11.2.0",
        "cheerio": "1.2.0",
        "cloudinary": "2.11.0",
        "dotenv": "18.0.4",
        "firebase-admin": "13.10.0",
        "google-auth-library": "11.1.0",
        "googleapis": "181.0.0",
        "openai": "7.15.0",
        "qrcode": "1.5.4",
        "sharp": "0.35.4",
        "twitter-api-v2": "1.29.1",
        "type-fest": "5.10.0"
    },
    "devDependencies": {
        "@types/node": "24.13.6",
        "@types/qrcode": "1.5.6",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vitest": "5.0.1"
    },
    "optionalDependencies": {
        "@esbuild/linux-x64": "0.28.2"
    },
    "packageManager": "pnpm@12.5.1"
}
